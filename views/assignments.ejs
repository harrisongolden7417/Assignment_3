<%- include('partials/header') %>
<%- include('partials/main_nav') %>

<!-- Main content -->
<main class="container mt-5 mb-5">

    <h1><%= title %></h1>

    <p>View and manage your upcoming assignments.</p>
    <!-- Navigate to the add assignment form -->
    <a href="/assignments/add" class="btn btn-primary mb-3">
        Add Assignment
    </a>

    <!-- Assignment table -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>Assignment Name</th>
                    <th>Course</th>
                    <th>Description</th>
                    <th>Due Date</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <!-- Loop through all assignments -->
                <% for(let count = 0; count < assignmentList.length; count++) { %>

                    <tr>
                        <td><%= assignmentList[count].name %></td>
                        <td><%= assignmentList[count].course %></td>
                        <td><%= assignmentList[count].description %></td>
                        <td><%= assignmentList[count].dueDate ? assignmentList[count].dueDate.toISOString().split('T')[0] : '' %></td>
                        <td><%= assignmentList[count].priority %></td>
                        <td><%= assignmentList[count].status %></td>
                        <!-- Assignment action buttons -->
                        <td>
                            <a href="/assignments/edit/<%= assignmentList[count]._id %>"
                                class="btn btn-warning">
                                Edit
                            </a>

                            <!-- Confirm before deleting an assignment -->
                            <form method="POST"
                                action="/assignments/delete/<%= assignmentList[count]._id %>"
                                class="d-inline"
                                onsubmit="return confirm('Are you sure you want to delete this assignment?');">

                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>

                            </form>
                        </td>
                    </tr>

                <% } %>

            </tbody>

        </table>
    </div>

</main>

<%- include('partials/footer') %>